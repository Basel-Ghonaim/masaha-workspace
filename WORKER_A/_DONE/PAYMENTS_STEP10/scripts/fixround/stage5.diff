+      {tags.map((tag, index) => (
+        <FilterTag
+          key={tag.key}
+          removeLabel={tag.removeLabel}
+          onRemove={() => {
+            removed.current = index;
+            tag.remove();
+          }}
+        >
           {tag.label}
         </FilterTag>
       ))}
       {clear !== null && (
-        <Button variant="link" size="sm" onClick={clear.run}>
+        <Button
+          variant="link"
+          size="sm"
+          onClick={() => {
+            removed.current = tags.length;
