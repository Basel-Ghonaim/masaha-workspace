@@ -0,0 +1,105 @@
+import request from 'supertest';
+import { beforeEach, describe, expect, it } from 'vitest';
+
+import { accessTokens, createTestApp } from '../../../test/app.ts';
+import { dataOf, errorOf, signIn } from '../../../test/admin.ts';
+import { createSpace } from '../../../test/factories.ts';
+import { resetDatabase } from '../../../test/reset-database.ts';
+import { seedSettings, signInOwnerOf } from '../../../test/spaces.ts';
+import { prisma } from '../../db/index.ts';
+
+const app = createTestApp({ clock: () => new Date('2026-10-15T09:00:00.000Z') });
+
+async function signInReceptionOf(spaceId: number) {
+  const user = await prisma.user.create({
+    data: {
+      email: `reception-${String(spaceId)}@example.com`,
+      name: 'Reception',
+      passwordHash: 'x',
+    },
+  });
+  await prisma.spaceManager.create({
+    data: { spaceId, userId: user.id, role: 'RECEPTION' },
+  });
+  const token = await accessTokens.sign({
+    userId: user.id,
+    mustChangePassword: false,
+    sessionVersion: user.sessionVersion,
+  });
+  return { id: user.id, authorization: 'Bearer ' + token };
+}
+
+function managed(spaceId: number, rest = '') {
+  return `/api/v1/manage/spaces/${String(spaceId)}${rest}`;
+}
+
+describe('managed space access', () => {
+  beforeEach(async () => {
+    await resetDatabase(prisma);
+    await seedSettings();
+  });
+
+  it('lets the owner and reception read the space', async () => {
+    const space = await createSpace();
+    const owner = await signInOwnerOf(space.id);
+    const reception = await signInReceptionOf(space.id);
+
+    const ownerResponse = await request(app)
+      .get(managed(space.id))
+      .set('Authorization', owner.authorization);
+    const receptionResponse = await request(app)
+      .get(managed(space.id))
+      .set('Authorization', reception.authorization);
+
+    expect(ownerResponse.status).toBe(200);
+    expect(receptionResponse.status).toBe(200);
+    expect(dataOf(receptionResponse)).toMatchObject({ id: space.id, isVerified: true });
+  });
+
+  it.each([
+    ['a guest', undefined],
+    ['an unlinked user', 'USER'],
+    ['an admin without a link', 'ADMIN'],
+  ] as const)('hides the space from %s', async (_name, caller) => {
+    const space = await createSpace();
+    const signedIn = caller ? await signIn(caller) : undefined;
+    const response = await request(app)
+      .get(managed(space.id))
+      .set('Authorization', signedIn?.authorization ?? '');
+
+    expect(response.status).toBe(caller ? 404 : 401);
+    if (caller) expect(errorOf(response).type).toBe('not_found');
+  });
+
+  it('keeps reception read-only while the owner can edit the profile', async () => {
+    const space = await createSpace();
+    const owner = await signInOwnerOf(space.id);
+    const reception = await signInReceptionOf(space.id);
+
+    const refused = await request(app)
+      .patch(managed(space.id))
+      .set('Authorization', reception.authorization)
+      .send({ nameEn: 'Changed by reception' });
+    const changed = await request(app)
+      .patch(managed(space.id))
+      .set('Authorization', owner.authorization)
+      .send({ nameEn: 'Changed by owner' });
+
+    expect(refused.status).toBe(403);
+    expect(changed.status).toBe(200);
+    expect((dataOf(changed) as { nameEn: string }).nameEn).toBe('Changed by owner');
+  });
+
+  it('returns not_found for a deleted linked space', async () => {
+    const space = await createSpace();
+    const owner = await signInOwnerOf(space.id);
+    await prisma.space.update({ where: { id: space.id }, data: { deletedAt: new Date() } });
+
+    const response = await request(app)
+      .get(managed(space.id))
+      .set('Authorization', owner.authorization);
+
+    expect(response.status).toBe(404);
+    expect(errorOf(response).type).toBe('not_found');
+  });
+});
